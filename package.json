{
  "name": "reinvent-english-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/build-sw.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "prepare-material": "tsx cli/prepare.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "dotenv": "17.2.3",
    "hono": "4.10.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "web-vitals": "5.1.0",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.9"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
