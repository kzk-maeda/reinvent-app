# npm run setup generates a random password in .env.
APP_PASSWORD=change-this-password-before-starting
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.local/lab.sqlite
# simulator | openai (switching requires restarting the server)
AI_PROVIDER=simulator
OPENAI_API_KEY=
TEXT_MODEL=gpt-6-luna
VOICE_MODEL=gpt-realtime-2.1
TRANSCRIPTION_MODEL=whisper-1
# Rates must be checked against your project's current pricing before paid use.
USD_JPY=150
MONTHLY_BUDGET_YEN=3000
VOICE_RESERVATION_YEN=500
VOICE_MAX_SECONDS=600
# iPhone/LAN access requires trusted HTTPS and an exact allowed origin.
# APP_ORIGIN=https://your-local-host:5173
# LOCAL_TLS_KEY=/absolute/path/to/local-key.pem
# LOCAL_TLS_CERT=/absolute/path/to/local-cert.pem
