# npm run setup generates a random password and session secret in .env.
APP_PASSWORD=change-this-password-before-starting
SESSION_SECRET=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.local/lab.sqlite
# simulator | openai (switching requires restarting the server)
AI_PROVIDER=simulator
OPENAI_API_KEY=
TEXT_MODEL=gpt-4.1-mini
VOICE_MODEL=gpt-realtime
TRANSCRIPTION_MODEL=whisper-1
# Rates must be checked against your project's current pricing before paid use.
USD_JPY=150
MONTHLY_BUDGET_YEN=3000
VOICE_RESERVATION_YEN=500
VOICE_MAX_SECONDS=600
